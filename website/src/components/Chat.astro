---
import { type Lang, T } from "../docs/i18n";
import { type PageScenes, chatContents } from "../render/chat";

interface Props {
  lang: Lang;
  scenes: PageScenes;
  class?: string;
}

const { lang, scenes, class: cls } = Astro.props;
const s = T[lang];
---

<aside class:list={["chat", cls]} aria-label={s.chatName} data-chat>
  <Fragment set:html={chatContents(scenes, s)} />
</aside>
